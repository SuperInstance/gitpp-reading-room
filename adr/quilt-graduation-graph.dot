// quilt-graduation-graph.dot
// Quilt graduation dependency graph — 15 named-scope packages, their roots,
// the @quilt/ai <-> @quilt/evolve cycle, and the three unrelated parties that
// already control the name "quilt".
//
// Generated by bruno-architect, 2026-10-18.
// Every "resolvable" claim was evaluated against the live npm registry.
// Companion machine-readable source: quilt-graduation-graph.json
//
//   red dashed  = npm CANNOT satisfy this edge today
//   purple bold = the ai <-> evolve cycle
//   orange bold = NAME CLAIM / supply-chain trap — never follow
//   green solid = resolvable today (file: protocol, vendored)

digraph quilt_graduation {
  rankdir=LR;
  compound=true;
  fontname="Helvetica";
  labelloc="t";
  label="Quilt graduation graph — 25 nodes / 27 edges — ZERO of the 15 scoped packages are on npm\nred dashed = unresolvable today · purple = cycle · orange = name trap · green = resolvable";
  nodesep=0.45;
  ranksep=1.1;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.16,0.08"];
  edge [fontname="Helvetica", fontsize=8, color="#b00020", style=dashed];

  // ---------------------------------------------------------------------
  // WHO ALREADY OWNS THE NAME "quilt" — none of these are SuperInstance
  // ---------------------------------------------------------------------
  subgraph cluster_owners {
    label="  NAME OWNERS — none of these are SuperInstance  ";
    color="#e07b00"; style="rounded,dashed"; penwidth=2; fontcolor="#e07b00"; fontsize=11;

    qorg   [label="GitHub org\nquilt\ncreated 2019-04-03\n38 public repos", fillcolor="#fff4e0", color="#e07b00"];
    qdorg  [label="GitHub org\nquiltdata\ncreated 2016-02-07\n87 public repos", fillcolor="#fff4e0", color="#e07b00"];
    qq     [label="@quilt/quilt@0.4.2\nON NPM\nmaintainer\nkevin@quilt.io", fillcolor="#ffe0cc", color="#e07b00"];
    qcore  [label="quilt-core@0.11.0\nON NPM\nniko-dellic/quilt\nMIT, 0 deps, 18 versions\nPANE-LAYOUT LIBRARY", fillcolor="#ffe0cc", color="#e07b00", penwidth=3];

    qdorg -> qq [label="  ownership", color="#e07b00", style=bold];
  }

  // ---------------------------------------------------------------------
  // ROOTS — two DIFFERENT products in this account both claim @quilt/core
  // ---------------------------------------------------------------------
  subgraph cluster_roots {
    label="  ROOTS — two different products, one name  ";
    color="#444"; style="rounded"; penwidth=2; fontcolor="#222"; fontsize=11;

    coreos [label="quilt-core-os  v0.4.0\nSuperInstance/quilt-core-os\n\"Quilt edge runtime — the TS\ndaemon inside the quilt-core snap\"\nApache-2.0 · better-sqlite3 · 32 blobs\nDECLARES name \"quilt-core\"\nNEVER PUBLISHED", fillcolor="#dbeafe", color="#1d4ed8", penwidth=3];
    qcore_m [label="@quilt/core  v0.3.0\nSuperInstance/quilt  packages/core\nspreadsheet-cell model\nyaml ^2.9.1 + zod ^4.6.5\nDECLARES name \"@quilt/core\"\nNEVER PUBLISHED", fillcolor="#dbeafe", color="#1d4ed8", penwidth=3];
    qsdk    [label="@quilt/sdk  v0.2.0\nSuperInstance/quilt  packages/sdk\nresolveArtifact · validateManifest\npublishArtifact · publishRunTrace", fillcolor="#dbeafe", color="#1d4ed8"];
  }

  // ---------------------------------------------------------------------
  // THE @quilt/* FAMILY — 9 packages, 0 on npm, 6 have dead edges
  // ---------------------------------------------------------------------
  subgraph cluster_quilt {
    label="  @quilt/* — 9 packages · 0 published · 6 blocked by @quilt/core or @quilt/sdk  ";
    color="#991b1b"; style="rounded"; penwidth=2; fontcolor="#991b1b"; fontsize=11;

    ai   [label="@quilt/ai  0.1.0\nquilt-ai · 88 KB\nworkspace: x2", fillcolor="#fee2e2", color="#991b1b"];
    evo  [label="@quilt/evolve  0.1.0\nquilt-evolve · 6.2 MB\nworkspace: x2", fillcolor="#fee2e2", color="#991b1b"];
    claw [label="@quilt/claw  0.1.0\nquilt-claw · 210 KB\n27 test files · 182 test() calls\nworkspace: x3\nCANNOT INSTALL", fillcolor="#fecaca", color="#7f1d1d", penwidth=3];
    elf  [label="@quilt/elf  0.1.0\nquilt-elf · 2.9 MB\n'@quilt/core':'*'", fillcolor="#fee2e2", color="#991b1b"];
    nom  [label="@quilt/nomad  0.1.0\nquilt-nomad · 2.9 MB\ncore + sdk", fillcolor="#fee2e2", color="#991b1b"];
    rag  [label="@quilt/rag  0.1.0\nquilt-rag · 7.1 MB\ncore + sdk + ai\nwidest fan-out", fillcolor="#fee2e2", color="#991b1b"];
    k3s  [label="@quilt/k3s  0.1.0\nquilt-k3s · 2.4 MB\npeer @quilt/core ^0.1.0", fillcolor="#fee2e2", color="#991b1b"];
    fleet  [label="@quilt/fleet  0.1.0\nquilt-fleet · 3.1 MB\nPUBLISH CI: release.yml\nALL DEPS THIRD-PARTY\nblocked by NAME only", fillcolor="#dcfce7", color="#15803d", penwidth=3];
    pincher[label="@quilt/pincher  0.1.0\nquilt-pincher · 2.8 MB\nPUBLISH CI: publish.yml\nZERO DEPENDENCIES\nblocked by NAME only", fillcolor="#dcfce7", color="#15803d", penwidth=3];
  }

  // ---------------------------------------------------------------------
  // @luciddreamer/* — 3 packages, 0 deps of their own, blocked by NAME only
  // ---------------------------------------------------------------------
  subgraph cluster_lucid {
    label="  @luciddreamer/* — blocked by NAME only (3 of the 5 failing publish CI)  ";
    color="#7c2d12"; style="rounded"; penwidth=2; fontcolor="#7c2d12"; fontsize=11;

    grid  [label="@luciddreamer/agent-grid  1.0.0\nagent-grid · 42 KB\nPUBLISH CI: publish.yml\ndeps: {} · peer: react 18|19", fillcolor="#ffedd5", color="#7c2d12", penwidth=2];
    cost  [label="@luciddreamer/cost-analysis  1.0.0\ncost-analysis · 17 KB\nPUBLISH CI: publish.yml\ndeps: recharts ^2.12.0", fillcolor="#ffedd5", color="#7c2d12", penwidth=2];
    mon   [label="@luciddreamer/monitoring-dashboard  1.0.0\nmonitoring-dashboard · 17 KB\nPUBLISH CI: publish.yml\ndeps: recharts ^2.12.0", fillcolor="#ffedd5", color="#7c2d12", penwidth=2];

    luciduser [label="GitHub USER 'luciddreamer'\nEXISTS (type=User)\ncreated 2023-04-26\n0 public repos\nthe ORG does NOT exist (404)", fillcolor="#fef3c7", color="#b45309", style="rounded,filled,dashed"];
  }

  // ---------------------------------------------------------------------
  // @cocapn/* — old name, renamed away; both deps are file: and resolvable
  // ---------------------------------------------------------------------
  subgraph cluster_cocapn {
    label="  @cocapn/* — old name, org 404s · deps are file:, so the graph is resolvable  ";
    color="#3f3f46"; style="rounded"; penwidth=2; fontcolor="#3f3f46"; fontsize=11;

    cba   [label="@cocapn/cocapn-browser-agent  0.1.0\ncocapn-browser-agent · 3.4 MB\ndeps: file:vendor/ x2", fillcolor="#f4f4f5", color="#3f3f46"];
    fcj   [label="@cocapn/fleet-coordinate-js  0.1.0\nfleet-coordinate-js · 3.4 MB\n0 deps · commits node_modules/", fillcolor="#f4f4f5", color="#3f3f46"];
    plc   [label="@cocapn/plato-client  0.1.0\nPHANTOM — no package.json\nrepo is a PYTHON package\n(cocapn_plato-0.1.0-py3-none-any.whl)", fillcolor="#ffffff", color="#71717a", peripheries=2, style="rounded,filled,dashed"];
  }

  // =====================================================================
  // EDGES — workspace:*  (npm: EUNSUPPORTEDPROTOCOL, reproduced)
  // =====================================================================
  ai  -> evo [label="workspace:*", color="#7e22ce", penwidth=3, style=bold];
  evo -> ai  [label="workspace:*", color="#7e22ce", penwidth=3, style=bold];

  ai  -> qcore_m [label="workspace:*"];
  evo -> qcore_m [label="workspace:*"];
  claw -> qcore_m [label="workspace:*"];

  claw -> ai  [label="workspace:*"];
  claw -> evo [label="workspace:*"];

  // =====================================================================
  // EDGES — bare '*' and ^0.1.0  (npm: HTTP 404)
  // =====================================================================
  elf -> qcore_m [label="'*'  → 404"];
  elf -> ai       [label="'*'  → 404"];
  nom -> qcore_m [label="'*'  → 404"];
  nom -> qsdk    [label="'*'  → 404"];
  rag -> qcore_m [label="'*'  → 404"];
  rag -> qsdk    [label="'*'  → 404"];
  rag -> ai      [label="'*'  → 404"];
  k3s -> qcore_m [label="peer ^0.1.0  → 404"];

  // =====================================================================
  // EDGES — resolvable today (file:)
  // =====================================================================
  cba -> fcj [label="file:vendor/\nfleet-coordinate-js", color="#15803d", style=solid, penwidth=2];
  cba -> plc [label="file:vendor/\nplato-client", color="#15803d", style=solid, penwidth=2];

  // =====================================================================
  // EDGES — NAME CLAIMS  (the dangerous ones)
  // =====================================================================
  qcore  -> coreos [label="  NAME CLAIM — SUPPLY-CHAIN TRAP\n  npm would install a STRANGER's\n  pane-layout library and run\n  its lifecycle scripts  ", color="#e07b00", style=bold, penwidth=4];
  qcore_m -> coreos [label="  NAME CLAIM — different products,\n  same name (packaging vs product)  ", color="#e07b00", style="bold,dashed", penwidth=3];
  qorg -> qcore_m [label="  no relationship · grants no scope  ", color="#e07b00", style="bold,dotted", fontcolor="#e07b00"];
  luciduser -> grid [label="  user holds the name; org does not exist  ", color="#b45309", style="bold,dotted"];
}

// =====================================================================
// DELIBERATELY NOT DRAWN — 6 edges that exist in the JSON companion.
// All six are internal to the `quilt` MONOREPO, whose four sibling
// packages are not among the fifteen and are not blocked by the
// @quilt/core naming decision. They are listed here so this file and
// quilt-graduation-graph.json cannot silently disagree.
//
//   @quilt/sdk   -> @quilt/core   "*"            (peer)   404  — qsdk IS drawn, edge is not
//   @quilt/mcp   -> @quilt/core   "*"                   404  — node not drawn
//   @quilt/cli   -> @quilt/core   "*"                   404  — node not drawn
//   @quilt/cli   -> @quilt/mcp    "*"                   404  — node not drawn
//   @quilt/cli   -> @quilt/sdk    "*"                   404  — node not drawn
//   @quilt/tui   -> @quilt/core   "file:../core"   RESOLVABLE  — node not drawn
//
// Note the asymmetry: @quilt/tui uses file: and resolves; @quilt/ai,
// @quilt/evolve and @quilt/claw use workspace: and cannot. That single
// protocol difference — not the cycle, not the name — is why three
// packages are stuck.
// =====================================================================
//
// CONTEXT, NOT AN EDGE — the quilt-* family is 257 repos (of 5,280 in the
// account), 0 archived, pushed Aug 47 / Sep 145 / Oct 65. Seven of them
// (quilt-arcade, quilt-arena, quilt-quant, quilt-dba, quilt-mesh,
// quilt-learn, loom-core) ship a BYTE-IDENTICAL engine/engine.js of
// 28,145 bytes — the `quilt-` prefix is a naming family, not 39 systems.
// Family size is a count, not a substance measure. Full figures in
// quilt-graduation-graph.json under "measured_family".
// =====================================================================
